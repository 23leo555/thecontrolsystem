# === The Control System — zmienne środowiskowe (przykład) ===
# Skopiuj do .env.local i uzupełnij. Nigdy nie commituj realnych sekretów.

# --- Publiczne (dostępne w przeglądarce) ---
NEXT_PUBLIC_SITE_URL=https://thecontrolsystem.biz
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# UWAGA: zmienne NEXT_PUBLIC_* są wstawiane podczas BUILDA, nie odczytywane w runtime.
# Po ich dodaniu/zmianie na Vercel konieczny jest redeploy.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Serwerowe (NIGDY nie eksponować w przeglądarce) ---
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
RESEND_FROM="Krystian Ćwik | The Control System <krystian.cwik@thecontrolsystem.biz>"
RESEND_REPLY_TO=krystian.cwik@thecontrolsystem.biz
CALENDLY_WEBHOOK_SIGNING_KEY=
CALENDLY_SCHEDULING_URL=
CALENDLY_ACCESS_TOKEN=
CALENDLY_ORGANIZATION_URI=
OWNER_EMAIL=krystian.cwik@thecontrolsystem.biz

# --- Reguły biznesowe (konfigurowalne bez zmian w kodzie) ---
# Bramka „tylko mężczyźni" — sekcja 11. Domyślnie OFF do czasu akceptacji prawnej.
MALE_ONLY_GATE=false
